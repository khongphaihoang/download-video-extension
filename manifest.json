{
  "manifest_version": 3,
  "name": "Video Grabber",
  "version": "0.3.2",
  "description": "Bắt mọi link video từ trang web đang mở, kể cả video trong group private trên Facebook.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Video Grabber"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referer",
        "enabled": true,
        "path": "rules/referer.json"
      }
    ]
  },
  "minimum_chrome_version": "116"
}